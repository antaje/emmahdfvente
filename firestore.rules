rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque compte ne voit et ne modifie que ses propres données.
    // L'identifiant du compte (ex. "emmahdf") correspond à la connexion "emmahdf@emmahdfvente.app".
    match /comptes/{compte}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == compte + '@emmahdfvente.app';
    }
    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
